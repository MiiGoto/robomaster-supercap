set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_TOOLCHAIN_BIN)
if(NOT DEFINED ARM_TOOLCHAIN_BIN)
  message(FATAL_ERROR "Set ARM_TOOLCHAIN_BIN to the existing arm-none-eabi tools/bin")
endif()
if(CMAKE_HOST_WIN32)
 set(TOOL_SUFFIX ".exe")
endif()
set(CMAKE_C_COMPILER "${ARM_TOOLCHAIN_BIN}/arm-none-eabi-gcc${TOOL_SUFFIX}")
set(CMAKE_ASM_COMPILER "${ARM_TOOLCHAIN_BIN}/arm-none-eabi-gcc${TOOL_SUFFIX}")
set(CMAKE_OBJCOPY "${ARM_TOOLCHAIN_BIN}/arm-none-eabi-objcopy${TOOL_SUFFIX}")
set(CMAKE_SIZE "${ARM_TOOLCHAIN_BIN}/arm-none-eabi-size${TOOL_SUFFIX}")
