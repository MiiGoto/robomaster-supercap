{
  "status": "PROTOTYPE SELECTION - NOT PROGRAMMED OR VERIFIED ON HARDWARE",
  "part": "BQ7694204PFBR",
  "source": "https://www.ti.com/lit/ug/sluuby1b/sluuby1b.pdf",
  "revision": "SLUUBY1B April2022",
  "accessed": "2026-10-04",
  "write_policy": "RAM only;no OTP burning or seal;read every configured byte back with SPI CRC before MON_CONFIG_VALID",
  "startup_policy": [
    "Keep MON_CONFIG_VALID LOW and ARM LOW throughout provisioning",
    "Read device identity;confirm BQ7694204 SPI/CRC startup variant",
    "Enter CONFIG_UPDATE;write each data-memory item with checksum/length per TRM;verify CRC readback",
    "Exit CONFIG_UPDATE;SLEEP_DISABLE0x009A;FET_INIT_OFF keeps logical permits off",
    "Check nine cell values,bank voltage,all independent NTCs and open-wire diagnosis",
    "Send0x0096 ALL_FETS_ON only after all checks;this releases host block but does not override protection. Never FET test commands;FET_ENABLE toggles state so must not be issued blindly",
    "Verify DCHG/DDSG healthy HIGH and fault LOW using cell simulator BEFORE any charged bank connection",
    "Enable MON_CONFIG_VALID only after all checks;any CRC/config/mode failure clears it and hardware latch",
    "Repeat provisioning after reset/power cycle;shutdown state high impedance must be pulled LOW externally"
  ],
  "balancing_policy": {
    "host_only": true,
    "maximum_simultaneous_cells": 1,
    "maximum_command_interval_s": 1,
    "bank_temperature_c": [
      0,
      40
    ],
    "minimum_cell_v": 2.3,
    "start_delta_mv": 20,
    "stop_delta_mv": 10,
    "require_converter_off": true,
    "require_all_measurements_valid": true,
    "note": "Slow trim,not protection substitute;settle before cell samples;firmware not implemented"
  },
